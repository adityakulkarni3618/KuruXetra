generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Season {
  id          String         @id @default(cuid())
  label       String         @unique
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  attendance  Attendance[]
  memberships Membership[]   @relation("SeasonMemberships")
  points      PointsLedger[]
  runs        RunningLog[]
  workouts    Workout[]
}

model User {
  id                String          @id @default(cuid())
  uniqueId          String          @unique
  passwordHash      String
  fullName          String
  rollNumber        String
  department        String
  academicYear      String
  mobileNumber      String
  email             String          @unique
  gender            String?
  dateOfBirth       DateTime?
  profilePhotoUrl   String?
  bloodGroup        String?
  studentIdCardUrl  String?
  fitnessGoal       String?
  role              Role            @default(STUDENT_ATHLETE)
  status            UserStatus      @default(PENDING_APPROVAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  collegeIdUrl      String?
  passoutYear       Int?
  priorRole         Role?
  resetOtp          String?
  resetOtpExpires   DateTime?
  announcements     Announcement[]
  attendance        Attendance[]
  meetingScores     MeetingScore[]  @relation("UserMeetingScores")
  memberships       Membership[]
  pointsEntries     PointsLedger[]
  madeRoleChanges   RoleChangeLog[] @relation("UserMadeRoleChanges")
  roleChangeLogs    RoleChangeLog[] @relation("UserRoleChanges")
  runs              RunningLog[]
  captainOf         Sport[]         @relation("SportCaptain")
  viceCaptainOf     Sport[]         @relation("SportViceCaptain")
  scheduledMeetings TeamMeeting[]   @relation("UserScheduledMeetings")
  workouts          Workout[]
  badges            UserBadge[]
  athleteSessionLogs AthleteSessionLog[]
}

model Sport {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  logoUrl       String?
  teamName      String?
  description   String?
  ground        String?
  practiceTime  String?
  maxMembers    Int?
  status        String         @default("ACTIVE")
  isActive      Boolean        @default(true)
  captainId     String?
  viceCaptainId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  attendance    Attendance[]
  memberships   Membership[]
  captain       User?          @relation("SportCaptain", fields: [captainId], references: [id])
  viceCaptain   User?          @relation("SportViceCaptain", fields: [viceCaptainId], references: [id])
  meetings      TeamMeeting[]
  sessions      Session[]
}

model WorkoutType {
  id        String    @id @default(cuid())
  name      String    @unique
  points    Int
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workouts           Workout[]
  sessionWorkouts    SessionWorkout[]
  athleteSessionLogs AthleteSessionLog[]
}

model Session {
  id          String              @id @default(cuid())
  sportId     String
  title       String
  startTime   DateTime
  status      String              @default("ACTIVE")
  createdAt   DateTime            @default(now())
  sport       Sport               @relation(fields: [sportId], references: [id])
  workouts    SessionWorkout[]
  athleteLogs AthleteSessionLog[]
}

model SessionWorkout {
  id            String       @id @default(cuid())
  sessionId     String
  workoutTypeId String?
  customName    String?
  rounds        Boolean      @default(false)
  session       Session      @relation(fields: [sessionId], references: [id])
  workoutType   WorkoutType? @relation(fields: [workoutTypeId], references: [id])
}

model AthleteSessionLog {
  id                  String       @id @default(cuid())
  sessionId           String
  userId              String
  workoutTypeId       String?
  customExerciseName  String?
  completed           Boolean      @default(false)
  value               Float?
  status              String       @default("PENDING")
  createdAt           DateTime     @default(now())
  session             Session      @relation(fields: [sessionId], references: [id])
  user                User         @relation(fields: [userId], references: [id])
  workoutType         WorkoutType? @relation(fields: [workoutTypeId], references: [id])
}

model MeetingScore {
  id        String      @id @default(cuid())
  meetingId String
  userId    String
  points    Int
  createdAt DateTime    @default(now())
  meeting   TeamMeeting @relation(fields: [meetingId], references: [id])
  user      User        @relation("UserMeetingScores", fields: [userId], references: [id])
}

model TeamMeeting {
  id          String         @id @default(cuid())
  sportId     String
  scheduledBy String
  title       String
  description String?
  scheduledAt DateTime
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  scores      MeetingScore[]
  author      User           @relation("UserScheduledMeetings", fields: [scheduledBy], references: [id])
  sport       Sport          @relation(fields: [sportId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  sportId   String?
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  sport     Sport?   @relation(fields: [sportId], references: [id])
}

model Membership {
  id       String           @id @default(cuid())
  userId   String
  sportId  String
  status   MembershipStatus @default(PENDING)
  joinedAt DateTime         @default(now())
  seasonId String?
  season   Season?          @relation("SeasonMemberships", fields: [seasonId], references: [id])
  sport    Sport            @relation(fields: [sportId], references: [id])
  user     User             @relation(fields: [userId], references: [id])

  @@unique([userId, sportId])
}

model Attendance {
  id          String    @id @default(cuid())
  userId      String
  sportId     String?
  seasonId    String?
  timeIn      DateTime  @default(now())
  timeOut     DateTime?
  durationMin Int?
  ground      String?
  markedBy    String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  season      Season?   @relation(fields: [seasonId], references: [id])
  sport       Sport?    @relation(fields: [sportId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Workout {
  id            String       @id @default(cuid())
  userId        String
  seasonId      String?
  name          String
  exercise      String?
  sets          Int?
  reps          Int?
  weightKg      Float?
  durationMin   Int?
  calories      Int?
  heartRate     Int?
  notes         String?
  photoUrl      String?
  createdAt     DateTime     @default(now())
  workoutTypeId String?
  season        Season?      @relation(fields: [seasonId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  workoutType   WorkoutType? @relation(fields: [workoutTypeId], references: [id])
}

model RunningLog {
  id             String   @id @default(cuid())
  userId         String
  seasonId       String?
  distanceKm     Float
  durationMin    Int
  paceMinKm      Float?
  calories       Int?
  avgSpeed       Float?
  maxSpeed       Float?
  notes          String?
  createdAt      DateTime @default(now())
  distanceMeters Int?
  rounds         Float?
  season         Season?  @relation(fields: [seasonId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String?
  points    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  season    Season?  @relation(fields: [seasonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model RoleChangeLog {
  id          String   @id @default(cuid())
  userId      String
  oldRole     Role
  newRole     Role
  changedById String
  changedAt   DateTime @default(now())
  changedBy   User     @relation("UserMadeRoleChanges", fields: [changedById], references: [id])
  user        User     @relation("UserRoleChanges", fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  CAPTAIN
  STUDENT_ATHLETE
  FITNESS_MEMBER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isManual    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  awards      UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id])
  awardedById String?
  earnedAt    DateTime @default(now())

  @@unique([userId, badgeId])
}
